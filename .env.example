# Server-only values. Do NOT prefix secrets with VITE_.
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=
# Neon free Postgres is the production store. Redis below is an alternative.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ACCESS_NAMESPACE=production
# Isolated test deployments only; requires a non-production ACCESS_NAMESPACE.
# Test mode uses a 15,000-token holding minimum; normal mode requires 1,000,000.
ACCESS_TEST_MODE=false
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional for local development only. Never accepted in production.
DEV_MEMORY_STORE=true
CHROME_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Robinhood Chain: 4663 mainnet, 46630 testnet. Use a dedicated RPC in production.
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=
# Leave these empty until the real ERC-20 token and terms are confirmed.
LARP_TOKEN_ADDRESS=
LARP_TREASURY_WALLET=
# Product terms: hold 1,000,000 LARP or pay $10 in ETH/LARP for 24 hours.
# ETH quotes use Coinbase ETH/USD. LARP automatically discovers the deepest
# eligible market for the exact CA on Robinhood. Optional pair pin (20 or 32 bytes).
LARP_PRICE_DEX_CHAIN=robinhood
LARP_PRICE_PAIR_ADDRESS=
# Optional read-only GMGN fallback when DEX Screener cannot quote LARP.
# Server secret; only Robinhood mainnet is supported by this integration.
GMGN_API_KEY=
